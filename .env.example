# Copy to .env, then run: .\.venv\Scripts\python.exe run_page\strava_auth.py
# Create your own application at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Written automatically by strava_auth.py. Do not use another athlete's token.
STRAVA_CLIENT_REFRESH_TOKEN=
STRAVA_ATHLETE_ID=

# First sync: last 90 days. Subsequent syncs: new activities + 7-day overlap.
STRAVA_RECENT_DAYS=90
# Optional proxy for this computer, e.g. http://127.0.0.1:12450
HTTPS_PROXY=
